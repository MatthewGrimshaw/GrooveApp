{
  //github copilot settings
    "chat.modeFilesLocations": {
    "chatmodes": true
  },
  "chat.promptFilesLocations": {
    "prompts": true
  },
  "chat.instructionsFilesLocations": {
    "instructions": true
  },

  // Python settings
  "python.defaultInterpreterPath": "${workspaceFolder}/api/.venv/Scripts/python.exe",
  "python.analysis.extraPaths": [
    "${workspaceFolder}/api"
  ],
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": [
    "api"
  ],
  "python.linting.enabled": true,
  "python.linting.pylintEnabled": false,
  "python.linting.flake8Enabled": true,
  "python.formatting.provider": "black",
  
  // TypeScript/Angular settings
  "typescript.tsdk": "app/node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  
  // Editor settings
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  },
  "editor.rulers": [80, 120],
  "editor.tabSize": 2,
  
  // File associations
  "files.associations": {
    "*.sql": "sql",
    "*.ps1": "powershell",
    "*.chatmode.md": "markdown",
    "*.instructions.md": "markdown",
    "*instructions.md": "markdown",
    "*.prompt.md": "markdown"
  },
  
  // Files to exclude from explorer
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/node_modules": true,
    "**/.angular": true,
    "**/dist": true
  },
  
  // Search exclude
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/__pycache__": true,
    "**/.venv": true
  },
  
  // SQL formatting
  "[sql]": {
    "editor.tabSize": 4
  },
  
  // Python formatting
  "[python]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  
  // PowerShell settings
  "[powershell]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  
  // Terminal settings
  "terminal.integrated.cwd": "${workspaceFolder}",
  "terminal.integrated.env.windows": {
    "PYTHONPATH": "${workspaceFolder}/api"
  }
}
