# Example Terraform Variables File
# Copy this file to environments/dev.tfvars, staging.tfvars, or prod.tfvars and fill in your values

# Azure Configuration
tenant_id       = "00000000-0000-0000-0000-000000000000"  # Your Azure AD tenant ID
subscription_id = "00000000-0000-0000-0000-000000000000"  # Your Azure subscription ID

# Environment Configuration
environment = "dev"  # Options: dev, staging, prod
location    = "eastus"

# Application Configuration
app_name = "grooveapp"

# Database Configuration - Choose ONE database type
database_type = "sql"  # Options: sql, postgres, cosmos

# SQL Database Configuration (required if database_type = "sql")
sql_admin_user_id        = "00000000-0000-0000-0000-000000000000"  # Object ID of the SQL admin user
sql_admin_user_principal = "admin@yourdomain.com"                   # UPN of the SQL admin user
sql_sku_name             = "S0"                                     # Options: Basic, S0, S1, P1, etc.

# PostgreSQL Configuration (required if database_type = "postgres")
# postgres_admin_username = "pgadmin"
# postgres_admin_password = "YourSecurePassword123!"  # Store in Key Vault or use -var in CLI
# postgres_sku_name       = "B_Standard_B1ms"         # Options: B_Standard_B1ms, GP_Standard_D2s_v3, etc.

# Cosmos DB Configuration (required if database_type = "cosmos")
# cosmos_consistency_level = "Session"  # Options: Eventual, Session, Strong, BoundedStaleness, ConsistentPrefix
# cosmos_throughput        = 400

# Container Registry Configuration
acr_sku = "Basic"  # Options: Basic, Standard, Premium

# App Service Plan Configuration
app_service_plan_sku = "B1"  # Options: B1, S1, P1v2, P2v2, P3v2

# Docker Image Tags
api_image_tag      = "latest"
frontend_image_tag = "latest"

# Authentication Configuration
enable_api_authentication      = true
enable_frontend_authentication = false
