# Environment Variables Template
# Copy this file to .env and update with your values (for reference only - not used by Docker script)

# Database Configuration
SQL_SERVER=sql-grooveapp-dev-uhxg.database.windows.net
SQL_DATABASE=sqldb-grooveapp-dev

# Azure Authentication (local development only)
# Token is automatically obtained by build-localApi.ps1
# AZURE_ACCESS_TOKEN=<obtained-via-az-cli>

# Azure Web App automatically provides these via Managed Identity
# No manual token configuration needed in production
